{
  "name": "adspark-digital-website",
  "private": true,
  "version": "1.0.0",
  "description": "AdSpark Digital corporate website built with React and Vite.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .ssr && node scripts/prerender.mjs",
    "build:root": "cross-env BASE_PATH=/ npm run build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist -t true"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "gh-pages": "^6.3.0",
    "vite": "^6.3.0"
  },
  "browserslist": [
    ">0.5%",
    "last 2 versions",
    "not dead",
    "Firefox ESR",
    "not op_mini all"
  ]
}
